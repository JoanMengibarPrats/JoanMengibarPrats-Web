---
import Layout from './Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const { title, description, pubDate, tags, image } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'es' ? '' : `/${lang}`;

const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
const formattedDate = pubDate.toLocaleDateString(
  lang === 'es' ? 'es-ES' : lang === 'va' ? 'ca-ES' : 'en-US',
  dateOptions
);
---

<Layout title={`${title} | Joan Francesc`} description={description} image={image} pubDate={pubDate} ogType="article">

  <div id="reading-progress" class="fixed top-0 left-0 w-full h-[2px] bg-green-500 origin-left z-[60] pointer-events-none" style="transform: scaleX(0);"></div>
  
  <div class="flex w-full min-h-screen justify-center">
    
    <div class="hidden xl:flex flex-1 justify-center">
      
      <aside class="sticky top-0 h-screen flex flex-col justify-center w-48 2xl:w-56 z-40">
        
        <div id="toc-wrapper" class="opacity-0 transition-opacity duration-500 max-h-[60vh] overflow-y-auto toc-scrollbar pr-4">
          <h4 class="font-syncopate text-white text-sm mb-6 uppercase tracking-widest border-b border-zinc-900 pb-4">
            > Index
          </h4>
          <nav id="toc-container" class="flex flex-col gap-4 border-l border-zinc-900 pl-4 relative font-mono text-sm">
            <div id="toc-indicator" class="absolute left-[-1px] top-0 w-[2px] h-0 bg-green-500 transition-all duration-300"></div>
          </nav>
        </div>

        <div class="mt-12 pt-8 border-t border-zinc-900/50">
          <a href={`${basePath}/blog`} class="group text-zinc-500 hover:text-green-400 font-mono text-sm transition-colors uppercase tracking-widest flex items-center w-fit">
            <span class="text-green-500 mr-2 transform transition-transform group-hover:-translate-x-1"></span> {t('blog.backToList')}
          </a>
        </div>

      </aside>

    </div>

    <main class="w-full max-w-3xl px-6 md:px-12 pt-32 pb-32 shrink-0 font-fira relative">
      <article class="w-full">
        
        <div class="mb-12 xl:hidden">
          <a href={`${basePath}/blog`} class="group text-zinc-500 hover:text-green-400 font-mono text-sm transition-colors uppercase tracking-widest flex items-center w-fit">
            <span class="text-green-500 mr-2 transform transition-transform group-hover:-translate-x-1"></span> blog
          </a>
        </div>

        <header class="mb-16">
          <h1 class="text-3xl md:text-5xl lg:text-6xl font-syncopate font-bold text-white mb-8 uppercase tracking-tighter leading-[1.1]">
            {title}
          </h1>
          
          <div class="flex flex-wrap items-center gap-4 text-zinc-500 font-mono text-xs md:text-sm border-b border-zinc-900 pb-8">
            <time datetime={pubDate.toISOString()}>
              {formattedDate}
            </time>
            {tags && tags.length > 0 && (
              <>
                <span class="text-zinc-800">|</span>
                <div class="flex gap-3">
                  {tags.map((tag: string) => (
                     <span class="text-green-500/80">#{tag}</span>
                  ))}
                </div>
              </>
            )}
          </div>
        </header>
        
        <div class="minimal-prose relative">
          <slot />
        </div>
        
        <footer class="mt-20 pt-12 border-t border-zinc-900">
          <a href={`${basePath}/blog`} class="group text-zinc-400 hover:text-green-400 font-mono text-base transition-colors uppercase tracking-widest flex items-center w-fit">
            <span class="text-green-500 mr-2 transform transition-transform group-hover:-translate-x-1"></span> {t('blog.backToList')}
          </a>
        </footer>

      </article>
    </main>

    <div class="hidden xl:block flex-1"></div>

  </div>
</Layout>

<style is:global>
  .toc-scrollbar::-webkit-scrollbar { width: 0px; background: transparent; }
  .toc-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .minimal-prose {
    color: #a1a1aa; 
    font-size: 1rem;
    line-height: 1.8;
    font-family: 'Fira Code', monospace;
  }
  
  @media (min-width: 768px) {
    .minimal-prose { font-size: 1.125rem; }
  }

  .minimal-prose p { margin-bottom: 2rem; }
  
  .minimal-prose h2 {
    font-family: 'Syncopate', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-top: 5rem;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    scroll-margin-top: 120px; 
  }
  
  @media (min-width: 768px) {
    .minimal-prose h2 { font-size: 2rem; }
  }
  
  .minimal-prose h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 120px;
  }

  .minimal-prose a {
    color: #e5e7eb;
    border-bottom: 1px solid #22c55e;
    text-decoration: none;
    transition: color 0.3s ease;
    padding-bottom: 1px;
  }
  .minimal-prose a:hover { color: #22c55e; }

  .minimal-prose blockquote {
    border-left: 1px solid #22c55e;
    padding-left: 1.5rem;
    margin: 3rem 0;
    color: #71717a; 
    font-style: italic;
  }

  .minimal-prose ul {
    list-style: none;
    margin-bottom: 2rem;
    padding-left: 0;
  }
  .minimal-prose ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .minimal-prose ul li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: #22c55e;
  }

  .minimal-prose ol {
    list-style-type: decimal-leading-zero;
    list-style-position: inside;
    margin-bottom: 2rem;
    padding-left: 0;
    color: #d4d4d8;
  }
  .minimal-prose ol li::marker {
    color: #22c55e;
    font-family: 'Syncopate', sans-serif;
  }

  .minimal-prose strong { color: #f4f4f5; font-weight: 700; }
  .minimal-prose code { color: #4ade80; font-size: 0.85em; }

  .minimal-prose pre {
    background-color: transparent;
    border: 1px solid #27272a;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 3rem 0;
    font-size: 0.9em;
  }
  .minimal-prose pre code { color: #d1d5db; }

  .minimal-prose img {
    width: 100%;
    margin: 3rem 0;
    transition: filter 0.5s ease;
  }
  .minimal-prose img:hover { filter: grayscale(0%) contrast(1); }

  .minimal-prose table {
    width: 100%;
    margin: 3rem 0;
    border-collapse: collapse;
    border: 1px solid #27272a;
    font-size: 0.9rem;
    color: #d4d4d8;
    display: block;
    overflow-x: auto;
  }

  .minimal-prose thead th {
    text-align: left;
    padding: 0.7rem 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #22c55e;
    border-bottom: 1px solid #22c55e;
    background: rgba(34, 197, 94, 0.05);
    white-space: nowrap;
  }

  .minimal-prose tbody td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid #27272a;
    white-space: nowrap;
  }

  .minimal-prose tbody tr:hover td {
    background: rgba(34, 197, 94, 0.03);
  }

  .minimal-prose table code {
    color: #4ade80;
    font-size: 0.85em;
  }

  .minimal-prose video {
    width: 100%;
    max-height: 78vh;
    margin: 3rem 0;
    border: 1px solid #27272a;
    background: #000;
  }

  .img-wrap {
    position: relative;
    margin: 3rem 0;
  }

  .img-wrap img {
    margin: 0;
    display: block;
    cursor: zoom-in;
  }

  .img-zoom-btn {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid #3f3f46;
    border-radius: 4px;
    color: #d4d4d8;
    opacity: 0.55;
    cursor: pointer;
    outline: none;
    transition: opacity 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .img-zoom-btn:hover {
    opacity: 1;
    border-color: #22c55e;
    color: #22c55e;
  }

  .img-zoom-btn:focus-visible {
    opacity: 1;
    border-color: #22c55e;
    color: #22c55e;
    outline: 2px solid #22c55e;
    outline-offset: 2px;
  }

  .img-zoom-btn svg {
    width: 20px;
    height: 20px;
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
    padding: 1.5rem;
    cursor: zoom-out;
  }

  .lightbox-overlay figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: default;
  }

  .lightbox-overlay img {
    max-width: 95vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    margin: 0;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
  }

  .lightbox-caption {
    margin: 1rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #a1a1aa;
    text-align: center;
    max-width: 60ch;
    cursor: default;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid #3f3f46;
    border-radius: 4px;
    color: #d4d4d8;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .lightbox-close:hover {
    border-color: #22c55e;
    color: #22c55e;
  }

  .lightbox-close:focus-visible {
    border-color: #22c55e;
    color: #22c55e;
    outline: 2px solid #22c55e;
    outline-offset: 2px;
  }

  .lightbox-close svg {
    width: 20px;
    height: 20px;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prose = document.querySelector('.minimal-prose');
    const tocWrapper = document.getElementById('toc-wrapper');
    const tocContainer = document.getElementById('toc-container');
    const indicator = document.getElementById('toc-indicator');

    if (!prose || !tocContainer || !tocWrapper) return;

    const headings = Array.from(prose.querySelectorAll('h2, h3'));
    
    if (headings.length === 0) {
      tocWrapper.style.display = 'none';
      return;
    }

    tocWrapper.classList.remove('opacity-0');
    const tocLinks: HTMLAnchorElement[] = [];

    headings.forEach((heading) => {
      if (!heading.id) {
        heading.id = (heading.textContent || '').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-');
      }

      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent;
      
      const isSubHeading = heading.tagName === 'H3';
      link.className = `block transition-colors duration-300 hover:text-green-400 leading-relaxed ${isSubHeading ? 'ml-3 text-zinc-600' : 'text-zinc-400'}`;
      
      tocContainer.appendChild(link);
      tocLinks.push(link);
    });

    let activeIndex = -1;

    const updateToc = () => {
      let current = -1;
      
      headings.forEach((heading, index) => {
        const rect = heading.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.4) {
          current = index;
        }
      });

      if (current === -1 && window.scrollY > 0) current = 0;

      if (current !== -1 && current !== activeIndex && indicator) {
        activeIndex = current;

        tocLinks.forEach((l, idx) => {
          const isSub = headings[idx].tagName === 'H3';
          l.classList.remove('text-green-500');
          l.classList.add(isSub ? 'text-zinc-600' : 'text-zinc-400');
        });

        const activeLink = tocLinks[activeIndex];
        activeLink.classList.remove('text-zinc-400', 'text-zinc-600');
        activeLink.classList.add('text-green-500');

        indicator.style.top = `${activeLink.offsetTop}px`;
        indicator.style.height = `${activeLink.offsetHeight}px`;
      }
    };

    window.addEventListener('scroll', updateToc, { passive: true });
    updateToc();
  });

  document.addEventListener('DOMContentLoaded', () => {
    const progressBar = document.getElementById('reading-progress');
    if (!progressBar) return;

    let rafId: number | null = null;

    const updateProgress = () => {
      rafId = null;
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      const progress = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      progressBar.style.transform = `scaleX(${progress})`;
    };

    const requestUpdate = () => {
      if (rafId === null) {
        rafId = requestAnimationFrame(updateProgress);
      }
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    updateProgress();
  });
</script>

<script>
  import gsap from "gsap";

  document.addEventListener('DOMContentLoaded', () => {
    const prose = document.querySelector('.minimal-prose');
    if (!prose) return;

    const images = Array.from(prose.querySelectorAll('img'));

    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', 'Imagen ampliada');
    overlay.style.display = 'none';

    const figure = document.createElement('figure');
    const bigImg = document.createElement('img');
    const caption = document.createElement('figcaption');
    caption.className = 'lightbox-caption';

    const closeBtn = document.createElement('button');
    closeBtn.className = 'lightbox-close';
    closeBtn.setAttribute('aria-label', 'Cerrar imagen');
    closeBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>`;

    figure.appendChild(bigImg);
    figure.appendChild(caption);
    overlay.appendChild(closeBtn);
    overlay.appendChild(figure);
    document.body.appendChild(overlay);

    let lastFocus: HTMLElement | null = null;

    const openLightbox = (img: HTMLImageElement, trigger: HTMLElement) => {
      lastFocus = trigger;
      bigImg.src = img.currentSrc || img.src;
      bigImg.alt = img.alt || '';
      caption.textContent = img.alt || '';
      caption.style.display = caption.textContent ? '' : 'none';
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      gsap.set(overlay, { opacity: 0 });
      gsap.to(overlay, { opacity: 1, duration: 0.25, ease: 'power2.out' });
      gsap.fromTo(figure, { scale: 0.92 }, { scale: 1, duration: 0.25, ease: 'power2.out' });
      closeBtn.focus();
    };

    const closeLightbox = () => {
      if (overlay.style.display === 'none') return;
      gsap.to(overlay, {
        opacity: 0,
        duration: 0.2,
        ease: 'power2.in',
        onComplete: () => {
          overlay.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
      if (lastFocus) lastFocus.focus();
    };

    closeBtn.addEventListener('click', closeLightbox);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    images.forEach((img) => {
      const wrap = document.createElement('div');
      wrap.className = 'img-wrap';
      img.parentNode?.insertBefore(wrap, img);
      wrap.appendChild(img);

      const btn = document.createElement('button');
      btn.className = 'img-zoom-btn';
      btn.setAttribute('aria-label', 'Ampliar imagen');
      btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M11 8v6M8 11h6"/></svg>`;
      wrap.appendChild(btn);

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openLightbox(img, btn);
      });
      img.addEventListener('click', () => openLightbox(img, img));
    });
  });
</script>